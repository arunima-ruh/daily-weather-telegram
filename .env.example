# ═══════════════════════════════════════════════════════════════════════════
# Daily Weather Telegram Bot — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ── Channel: Telegram ────────────────────────────────────────────────────────
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
# Get TELEGRAM_CHAT_ID from @userinfobot or your group/channel settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Connector: Weather ───────────────────────────────────────────────────────
# Location for weather forecast (default: Sasaram)
LOCATION=Sasaram

# ── Infrastructure: Database (Optional) ──────────────────────────────────────
# PostgreSQL connection string for delivery audit trail
# Agent works WITHOUT this — database is optional
# PG_CONNECTION_STRING=postgresql://user:password@host:5432/dbname
# ORG_ID=default
# AGENT_ID=daily-weather-telegram
